#!/usr/bin/env bash
# Global commit-msg hook — enforce the user's commit-message policy across
# every repo where core.hooksPath is not overridden (husky / lefthook /
# repo-local .githooks/ break this layer; layered defenses cover those).
#
# Per-repo opt-out:    git config commit.skipGlobalHook true
# Per-commit bypass:   git commit --no-verify

set -euo pipefail

msg_file="${1:-}"
[[ -z "$msg_file" || ! -f "$msg_file" ]] && exit 0

if [[ "$(git config --get commit.skipGlobalHook 2>/dev/null)" == "true" ]]; then
    exit 0
fi

# Block co-author trailers and AI attribution lines anywhere in the message.
# Same regex as ~/save.sh and the Claude commit-policy-gate hook.
if grep -qiE '^[^[:alnum:]]*(Co-Authored-By[[:space:]]*:|Generated with \[?Claude)' "$msg_file"; then
    cat >&2 <<'EOF'
✗ commit-msg: co-author / AI attribution is disabled by user policy.

  Remove the `Co-Authored-By: ...` and "Generated with Claude Code" line(s)
  from the commit message and retry.

  Per-commit bypass:    git commit --no-verify
  Per-repo opt-out:     git config commit.skipGlobalHook true
EOF
    exit 1
fi

exit 0
